# Neon (Postgres) — reemplaza con tu connection string real, nunca lo subas a git
DATABASE_URL="postgresql://<usuario>:<password>@<host-neon>.neon.tech/<database>?sslmode=require"

# Sesión (express-session)
SESSION_SECRET=changeme

# Servidor
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (Angular en desarrollo)
FRONTEND_URL=http://localhost:4200

# Recurrente — se llena cuando tengamos credenciales reales del procesador
RECURRENTE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=tu_client_id
GOOGLE_CLIENT_SECRET=tu_client_secret
FRONTEND_URL=http://localhost:4200

