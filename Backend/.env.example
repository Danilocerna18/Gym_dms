# AWS RDS (Postgres) — reemplaza con tu connection string real, nunca lo subas a git
# El session store (pg) verifica el certificado con certs/global-bundle.pem cuando el host es RDS.
DATABASE_URL="postgresql://<usuario>:<password>@<instancia>.<id>.<region>.rds.amazonaws.com:5432/<database>?sslmode=require"

# Sesión (express-session)
SESSION_SECRET=changeme

# Servidor
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (Angular en desarrollo)
FRONTEND_URL=http://localhost:4200

# Recurrente — se llena cuando tengamos credenciales reales del procesador
RECURRENTE_WEBHOOK_SECRET=

# Google Auth
GOOGLE_CLIENT_ID=tu_client_id
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Variables recomendadas para sesión y proxy ---
# En desarrollo deja SESSION_COOKIE_SECURE=false; en producción debe ser true (HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=gysess
# Si tu app está detrás de un proxy (Heroku, Vercel, etc.) activa esto
TRUST_PROXY=true
# Resend: API key con permiso de envío y remitente de un dominio verificado
RESEND_API_KEY=
RESET_MAIL_FROM=
